# Server-side only. Copy to .env. Never commit .env or real key values.
# Never put Stripe secrets or sb_secret_ / service_role keys in apps/web.

# --- Supabase Auth (OTP in the browser; JWT on this API) ---
# Browser calls apps/api, which POSTs {SUPABASE_URL}/auth/v1/otp and /verify
# (Gotrue HTTP). No supabase-js. No passwords. Account first — no card.
#
# Dedicated Ardoise project (Dashboard → that project only). Public URL/ref;
# not an Arbusteia project. Do not paste keys here — set them in local .env
# or the host secret store.
#
# Dashboard → Project Settings → Data API (URL):
SUPABASE_URL=https://yokxvbgzcoaayahouhsd.supabase.co
#
# Dashboard → Project Settings → API Keys
#   Publishable (`sb_publishable_…`)  → SUPABASE_ANON_KEY or SUPABASE_PUBLISHABLE_KEY
#   Legacy anon JWT (`eyJ…`)          → SUPABASE_ANON_KEY (same slot)
#   Secret (`sb_secret_…`)            → SUPABASE_SERVICE_ROLE_KEY or SUPABASE_SECRET_KEY
#   Legacy service_role JWT (`eyJ…`)  → SUPABASE_SERVICE_ROLE_KEY (same slot)
# Prefer the publishable/anon key for OTP. Secret/service_role is server-only
# fallback if the public key is unset. Never send secret keys to apps/web.
SUPABASE_ANON_KEY=
SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_SECRET_KEY=
#
# Dashboard → Project Settings → JWT Keys → JWT Secret (legacy HS256).
# Optional. If unset — or if the value is itself a JWT / sb_* key — the API
# verifies access tokens via JWKS:
#   {SUPABASE_URL}/auth/v1/.well-known/jwks.json
# Use JWKS when the Dashboard only shows a signing key id (no HS256 secret).
# Mock OTP verify mints a local JWT when this is a raw secret and Supabase
# keys are not set.
SUPABASE_JWT_SECRET=

# --- Postgres (Supabase primary, not a replica). Apply migrations/*.sql ---
# When set, the API uses Postgres (ops.*) as the system of record. Leave
# unset to keep accounts/credits in local SQLite (`.data/local.db`).
# Optional for Auth OTP e2e: Gotrue OTP + JWT verify are HTTP-only and do
# not need the database password. Privileged service role only — never put
# this URI in the browser or expose ops on PostgREST.
DATABASE_URL=postgresql://postgres:PASSWORD@db.YOUR_PROJECT.supabase.co:5432/postgres
# ARDOISE_API_SQLITE=.data/local.db   # ignored when DATABASE_URL is set

# --- Stripe Checkout Sessions. Not Connect. Secrets stay on this process. ---
# Restricted key (rk_test_…) preferred over sk_test_…. Never send to the client.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=whsec_...
# Pro $20/mo and Team $49/mo — Dashboard Price IDs (recurring monthly).
# Create one Product per plan; attach a monthly Price. Do not put both tiers
# on a single Product. Fallback: inline price_data when a Price ID is unset.
# Test-mode IDs already created (not secrets). Unset STRIPE_PRICE_BUSINESS —
# that Business price is archived.
STRIPE_PRICE_PRO=price_1UFItuLXeKVxcTxwwvakV7CI
STRIPE_PRICE_TEAM=price_1UFIu0LXeKVxcTxwN5l52Fzf
# Legacy PAYG credits (POST /v1/checkout/sessions, mode=payment).
STRIPE_PRICE_LOOKUP_KEY=ardoise_credits_20
STRIPE_PRICE_ID=
STRIPE_DEFAULT_AMOUNT_CENTS=2000
STRIPE_DEFAULT_CREDITS=2000
# true, or missing STRIPE_SECRET_KEY → local mock session (offline tests).
STRIPE_MOCK=true
# Tax: enable Stripe Tax in the Dashboard only after you have an active
# registration. This API does not set automatic_tax.

# --- App ---
ARDOISE_ENV=development
ARDOISE_PUBLIC_URL=http://127.0.0.1:8787
ARDOISE_WEB_ORIGIN=http://localhost:3000
CHECKOUT_SUCCESS_URL=http://localhost:3000/billing/success
CHECKOUT_CANCEL_URL=http://localhost:3000/billing/cancel
# Lab-only auth bypass. OFF by default. Ignored when ARDOISE_ENV=production.
ARDOISE_LAB_AUTH_BYPASS=false
