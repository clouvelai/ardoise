# Server-side only. Copy to .env. Never put Stripe secrets in apps/web.

# --- Supabase Auth (OTP in the browser; JWT on this API) ---
# Browser calls apps/api, which POSTs {SUPABASE_URL}/auth/v1/otp and /verify
# (Gotrue HTTP). No supabase-js. No passwords. Account first — no card.
SUPABASE_URL=https://YOUR_PROJECT.supabase.co
SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.YOUR_ANON_KEY
# Server-only fallback if the anon key is unset. Never send to apps/web.
SUPABASE_SERVICE_ROLE_KEY=
# HS256 verify (Dashboard → Project Settings → API → JWT Secret).
# If unset, the API falls back to JWKS at {SUPABASE_URL}/auth/v1/.well-known/jwks.json
# Mock OTP verify mints a local JWT when this is set and Supabase keys are not.
SUPABASE_JWT_SECRET=

# --- Postgres (Supabase primary, not a replica). Apply migrations/*.sql ---
DATABASE_URL=postgresql://postgres:PASSWORD@db.YOUR_PROJECT.supabase.co:5432/postgres
# Local mock smoke uses SQLite when DATABASE_URL is unset.
# ARDOISE_API_SQLITE=.data/local.db

# --- Stripe Checkout Sessions. Not Connect. Secrets stay on this process. ---
# Restricted key (rk_test_…) preferred over sk_test_…. Never send to the client.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=whsec_...
# Team $39/mo and Business $149/mo — Dashboard Price IDs (recurring monthly).
# Create one Product per plan; attach a monthly Price. Do not put both tiers
# on a single Product. Fallback: inline price_data when a Price ID is unset.
STRIPE_PRICE_TEAM=price_...
STRIPE_PRICE_BUSINESS=price_...
# Legacy PAYG credits (POST /v1/checkout/sessions, mode=payment).
STRIPE_PRICE_LOOKUP_KEY=ardoise_credits_20
STRIPE_PRICE_ID=
STRIPE_DEFAULT_AMOUNT_CENTS=2000
STRIPE_DEFAULT_CREDITS=2000
# true, or missing STRIPE_SECRET_KEY → local mock session (offline tests).
STRIPE_MOCK=true
# Tax: enable Stripe Tax in the Dashboard only after you have an active
# registration. This API does not set automatic_tax.

# --- App ---
ARDOISE_ENV=development
ARDOISE_PUBLIC_URL=http://127.0.0.1:8787
ARDOISE_WEB_ORIGIN=http://localhost:3000
CHECKOUT_SUCCESS_URL=http://localhost:3000/billing/success
CHECKOUT_CANCEL_URL=http://localhost:3000/billing/cancel
# Lab-only auth bypass. OFF by default. Ignored when ARDOISE_ENV=production.
ARDOISE_LAB_AUTH_BYPASS=false
